# Homebrew package set for macOS.
# Used by install/mac.sh via `brew bundle`.

# Core CLI
brew "jq"
brew "tmux"
brew "gh"
brew "ripgrep"
brew "fd"
brew "fzf"

# Networking / remote access
# OpenVPN CLI client — connect with: `sudo openvpn --config your.ovpn`.
# (This is the command-line client, NOT the Tunnelblick GUI.)
brew "openvpn"
# Tailscale — mesh VPN. brew ships the CLI + tailscaled daemon; after install
# start the system daemon once, then bring the node up:
#   sudo tailscaled install-system-daemon
#   sudo tailscale up
# (install/mac.sh prints this reminder after `brew bundle`.)
brew "tailscale"

# Greeting eye-candy (greet.sh detects + uses these if present)
brew "figlet"
brew "lolcat"

# Python toolchain — uv replaces pyenv + pip + poetry combo.
# `uv python install <ver>` provisions any Python on demand.
brew "uv"

# WezTerm — GPU-accelerated cross-platform terminal emulator (Lua config).
# Picked over iTerm2 because the same config works on mac/linux/windows;
# default config: ~/.wezterm.lua or ~/.config/wezterm/wezterm.lua.
cask "wezterm"

# Node + npm (brew "node" includes npm). Non-mac paths install node via the
# system pm + then `npm i -g` from pkgs/npm-global.txt; mac skips that step
# because brew handles codex natively (cask below).
brew "node"

# Anthropic Claude Code — CLI binary (NOT a GUI .app, same caveat as codex
# below). The cask drops a single Mach-O binary into /opt/homebrew/bin/claude.
# Update with `brew upgrade --cask`. `brew install claude-code` auto-resolves
# to this cask. Non-mac platforms use `npm i -g @anthropic-ai/claude-code`
# from pkgs/npm-global.txt.
cask "claude-code"

# OpenAI Codex — CLI binary (NOT a GUI .app, the cask name is misleading).
# Homebrew uses `cask` here because upstream ships a prebuilt Rust binary at
#   https://github.com/openai/codex/releases/download/rust-v<ver>/codex-<arch>-<os>.tar.gz
# which doesn't fit formula's build-from-source convention. The cask drops
# the binary into /opt/homebrew/bin/codex + auto-generates shell completions
# for bash/zsh/fish. Update with `brew upgrade --cask`.
# (There is no `formula` named codex — `brew install codex` resolves to this
# cask automatically. Non-mac platforms use `npm i -g @openai/codex` from
# pkgs/npm-global.txt instead, which is a Node script wrapper.)
cask "codex"
