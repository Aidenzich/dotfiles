# Homebrew package set for macOS.
# Used by install/mac.sh via `brew bundle`.

# Core CLI
brew "jq"
brew "tmux"
brew "gh"
brew "ripgrep"
brew "fd"
brew "fzf"

# Greeting eye-candy (greet.sh detects + uses these if present)
brew "figlet"
brew "lolcat"

# Python toolchain — uv replaces pyenv + pip + poetry combo.
# `uv python install <ver>` provisions any Python on demand.
brew "uv"

# Node + npm (brew "node" includes npm). Non-mac paths install node via the
# system pm + then `npm i -g` from pkgs/npm-global.txt; mac skips that step
# because brew handles codex natively (cask below).
brew "node"

# OpenAI Codex — CLI binary (NOT a GUI .app, the cask name is misleading).
# Homebrew uses `cask` here because upstream ships a prebuilt Rust binary at
#   https://github.com/openai/codex/releases/download/rust-v<ver>/codex-<arch>-<os>.tar.gz
# which doesn't fit formula's build-from-source convention. The cask drops
# the binary into /opt/homebrew/bin/codex + auto-generates shell completions
# for bash/zsh/fish. Update with `brew upgrade --cask`.
# (There is no `formula` named codex — `brew install codex` resolves to this
# cask automatically. Non-mac platforms use `npm i -g @openai/codex` from
# pkgs/npm-global.txt instead, which is a Node script wrapper.)
cask "codex"
